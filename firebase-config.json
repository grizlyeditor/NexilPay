  "settings": {
    "appName": "Nexi Wallet",
    "version": "1.0.0",
    "currency": {
      "USD": {
        "symbol": "$",
        "name": "US Dollar"
      },
      "RON": {
        "symbol": "RON",
        "name": "Romanian Leu"
      }
    },
    "exchangeRate": 0.56,
    "minDeposit": 1.00,
    "maxDeposit": 10000.00,
    "minWithdrawal": 1.00,
    "maxWithdrawal": 5000.00,
    "transactionFee": 0.00,
    "redeemCodeExpiryDays": 30,
    "supportedCountries": ["US", "RO", "IN", "PK"],
    "maintenanceMode": false,
    "debugMode": true
  },
  
  "collections": {
    "users": {
      "fields": ["uid", "username", "cnic", "password", "email", "usdBalance", "ronBalance", "createdAt", "lastLogin", "status"],
      "indexes": ["username", "cnic", "email"]
    },
    "wallets": {
      "fields": ["userId", "totalUSD", "totalRON", "totalSent", "totalReceived", "transactions", "createdAt", "updatedAt"],
      "indexes": ["userId"]
    },
    "transactions": {
      "fields": ["id", "type", "senderId", "receiverId", "amount", "currency", "timestamp", "status", "notes"],
      "indexes": ["senderId", "receiverId", "timestamp", "status"]
    },
    "redeemCodes": {
      "fields": ["code", "amount", "currency", "createdBy", "createdAt", "expiresAt", "isRedeemed", "redeemedBy", "redeemedAt"],
      "indexes": ["code", "createdBy", "isRedeemed", "expiresAt"]
    }
  },
  
  "securityRules": {
    "firestore": {
      "rulesVersion": "2",
      "rules": {
        "users": {
          "read": "auth != null && (request.auth.uid == resource.data.uid || resource.data.isPublic == true)",
          "write": "auth != null && request.auth.uid == resource.data.uid"
        },
        "wallets": {
          "read": "auth != null && request.auth.uid == resource.data.userId",
          "write": "auth != null && request.auth.uid == resource.data.userId"
        },
        "transactions": {
          "read": "auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId)",
          "write": "auth != null"
        },
        "redeemCodes": {
          "read": "true",
          "write": "auth != null"
        }
      }
    },
    "storage": {
      "rules": {
        "profileImages/{userId}": {
          "read": "auth != null",
          "write": "auth != null && request.auth.uid == userId"
        }
      }
    }
  },
  
  "admin": {
    "email": "admin@nexi.com",
    "permissions": ["read_all", "write_all", "delete_users", "manage_transactions"],
    "users": ["firebase-adminsdk-fbsvc@ejene-d8ff7.iam.gserviceaccount.com"]
  },
  
  "api": {
    "endpoints": {
      "register": "/api/register",
      "login": "/api/login",
      "send": "/api/send",
      "redeem": "/api/redeem",
      "balance": "/api/balance",
      "transactions": "/api/transactions"
    },
    "rateLimiting": {
      "requestsPerMinute": 60,
      "requestsPerHour": 1000
    }
  }
